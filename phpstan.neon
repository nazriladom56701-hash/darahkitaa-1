includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 4

    ignoreErrors:
        - '#Access to an undefined property Illuminate\\Database\\Eloquent\\Model::#'
        - '#uses generic trait Illuminate\\Database\\Eloquent\\Factories\\HasFactory#'
        - '#return type with generic class Illuminate\\Database\\Eloquent\\Relations#'
        - '#Parameter \#1 \$stream of function (fputcsv|fprintf|fclose) expects resource, resource\|false given#'
        - '#Access to an undefined property App\\Models\\Donor\|Illuminate\\Database\\Eloquent\\Collection#'